# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
PORT=4000
# Se usa para armar la URL pública de los comprobantes guardados en disco local
BASE_URL=http://localhost:4000
# development | production (en production se exige JWT_SECRET fuerte)
NODE_ENV=development
# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super-secret-cambiar
# Orígenes permitidos, separados por coma. Vacío = mismo origen que el backend
CORS_ORIGIN=http://localhost:5500

# ──────────────────────────────────────────────────────────────
# Postgres
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/egresos_db
# true en proveedores gestionados (Seenode, Heroku, Neon…), false en local
PGSSL=false
# Pool de conexiones. Defaults del código: min 2 / max 20
# Referencia: 2 CPU -> 2/20 · 4 CPU -> 5/40 · 8+ CPU -> 10/80
PG_POOL_MIN=2
PG_POOL_MAX=20

# ──────────────────────────────────────────────────────────────
# Uploads de comprobantes
# ──────────────────────────────────────────────────────────────
# Carpeta de disco local (fallback cuando IMGBB_API_KEY no está configurada)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Almacenamiento externo de imágenes. Si está vacío se usa el disco local,
# que en plataformas con filesystem efímero se pierde en cada deploy.
# Obtener la key en https://api.imgbb.com/
IMGBB_API_KEY=

# ──────────────────────────────────────────────────────────────
# GATE — autocompletado de egreso desde comprobante (opcional)
# ──────────────────────────────────────────────────────────────
# Si faltan, el form funciona igual pero sin autofill al subir el archivo.
# RECEIPT_GATE_URL=https://receipt-gate-staging.seenode.app
# RECEIPT_GATE_TOKEN=
# RECEIPT_GATE_TIMEOUT_MS=90000

# ──────────────────────────────────────────────────────────────
# Caché de saldos (GET /api/egresos/saldos)
# ──────────────────────────────────────────────────────────────
SALDOS_CACHE_TTL_MS=15000
SALDOS_CACHE_MAX_ENTRIES=100

# ──────────────────────────────────────────────────────────────
# Balance diario (CSV de banco → planilla de cargas + balance mensual)
# ──────────────────────────────────────────────────────────────
# Cuenta de servicio: scraper-sheets@trazabilidad-492505.iam.gserviceaccount.com
# En Seenode pegá el JSON completo en GOOGLE_CREDENTIALS_JSON.
# En local podés apuntar al archivo (no lo subas al repo):
# GOOGLE_CREDENTIALS_PATH=C:\Users\hp\scraper\trazabilidad-492505-bd418988874f.json
# GOOGLE_CREDENTIALS_JSON=
# Planilla de cargas del mes (pestañas 1…31). Si cambia el spreadsheet por mes:
# PLANILLA_CARGAS_SHEETS={"2026-09":"<id septiembre>","2026-10":"<id octubre>"}
PLANILLA_CARGAS_SHEET_ID=
# Spreadsheet del balance del mes. La hoja destino es "Balance Mensual Bancario".
BALANCE_DEF_SHEET_ID=
# BALANCE_DEF_TAB=Balance Mensual Bancario
# Titular de cuenta de Riven (el CSV no lo trae).
RIVEN_TITULAR=
# DEPOSITO_TOL_PESOS=100
# PLANILLA_HORA_TOL_MIN=20

# ──────────────────────────────────────────────────────────────
# Seed del primer admin (npm run seed:admin)
# ──────────────────────────────────────────────────────────────
SEED_ADMIN_USERNAME=admin
# Obligatoria: el script no tiene contraseña por defecto y valida la política
# (8+ caracteres, mayúscula, minúscula, número y carácter especial)
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULLNAME=Administrador
