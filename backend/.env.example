# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
PORT=4000
# Se usa para armar la URL pública de los comprobantes guardados en disco local
BASE_URL=http://localhost:4000
# development | production (en production se exige JWT_SECRET fuerte)
NODE_ENV=development
# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super-secret-cambiar
# Orígenes permitidos, separados por coma. Vacío = mismo origen que el backend
CORS_ORIGIN=http://localhost:5500

# ──────────────────────────────────────────────────────────────
# Postgres
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/egresos_db
# true en proveedores gestionados (Seenode, Heroku, Neon…), false en local
PGSSL=false
# Pool de conexiones. Defaults del código: min 2 / max 20
# Referencia: 2 CPU -> 2/20 · 4 CPU -> 5/40 · 8+ CPU -> 10/80
PG_POOL_MIN=2
PG_POOL_MAX=20

# ──────────────────────────────────────────────────────────────
# Uploads de comprobantes
# ──────────────────────────────────────────────────────────────
# Carpeta de disco local (fallback cuando IMGBB_API_KEY no está configurada)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Almacenamiento externo de imágenes. Si está vacío se usa el disco local,
# que en plataformas con filesystem efímero se pierde en cada deploy.
# Obtener la key en https://api.imgbb.com/
IMGBB_API_KEY=

# ──────────────────────────────────────────────────────────────
# Caché de saldos (GET /api/egresos/saldos)
# ──────────────────────────────────────────────────────────────
SALDOS_CACHE_TTL_MS=15000
SALDOS_CACHE_MAX_ENTRIES=100

# ──────────────────────────────────────────────────────────────
# Endpoints de mantenimiento (apagados por default)
# ──────────────────────────────────────────────────────────────
# Habilita /api/run-migrations, /api/init-admin y /api/fix-id-transferencia.
# Ejecutan DDL: dejarlo en false salvo durante una ventana de mantenimiento,
# y volverlo a false al terminar.
ENABLE_MAINTENANCE_ENDPOINTS=false
# Datos del admin que crea POST /api/init-admin (solo si no existe ningún admin)
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_FULLNAME=Administrador
# Debe cumplir la política de contraseñas (8+ caracteres, mayúscula, número, especial)
INIT_ADMIN_PASSWORD=

# ──────────────────────────────────────────────────────────────
# Seed de admin por CLI (npm run seed:admin)
# ──────────────────────────────────────────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=cambiar-antes-de-usar
SEED_ADMIN_FULLNAME=Administrador
