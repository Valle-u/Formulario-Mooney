# Plantilla SIN secretos (va a main). Valores reales:
#   C:\Users\lauta\Desktop\credenciales\receipt-gate.env
# Setup: powershell -File scripts\use-credenciales.ps1
# Ver docs/07_CREDENCIALES.md

# ── Servidor ──────────────────────────────────────────────────────────────
PORT=4100
NODE_ENV=development
DB_PATH=./data/receipt-gate.db
RECEIPT_STORAGE_PATH=./data/receipts

# URL pública del gate (para view_url en respuestas). En prod: https://gate.tudominio.com
RECEIPT_PUBLIC_URL=http://localhost:4100

# ── Auth ────────────────────────────────────────────────────────────────────
RECEIPT_GATE_TOKENS=
# Secreto HMAC para tokens de vista (?token= en GET /receipts/:id). Obligatorio en production.
RECEIPT_VIEW_SECRET=
RECEIPT_VIEW_TTL_HOURS=168

# ── ClamAV (Capa 0) ──────────────────────────────────────────────────────────
RECEIPT_CLAMAV_ENABLED=false
RECEIPT_CLAMAV_FAIL_CLOSED=true
CLAMD_SOCKET=/var/run/clamav/clamd.ctl
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMSCAN_PATH=/usr/bin/clamscan

# ── Capa 2 — extracción forense (IA) ─────────────────────────────────────────
RECEIPT_FORENSIC_ENABLED=true
# auto = obligatorio en production, opcional en development
RECEIPT_FORENSIC_REQUIRED=auto
# Estrategia multi-proveedor: Claude (primario) → OpenAI → Gemini.
# Se usa el primer proveedor con key configurada; ante fallo cae al siguiente.

# Anthropic Claude (primario) — misma key que el CRM
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_VERSION=2023-06-01

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4o
# Gemini (fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Telemetría ────────────────────────────────────────────────────────────────
RECEIPT_STATS_MIN=1440

# ── Mantenimiento ─────────────────────────────────────────────────────────────
# Minutos entre corridas de limpieza de comprobantes expirados (0 = deshabilitar).
RECEIPT_CLEANUP_INTERVAL_MIN=60
