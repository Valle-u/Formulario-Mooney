{
  "name": "receipt-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GATE — servicio aislado de comprobantes (Capa 1+2): saneo, extracción IA, banco, vista segura. Recibe archivos crudos de CRM/PAM y devuelve JPEG limpio + metadata. Host sacrificable; no decide dinero.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:normalize": "tsx scripts/test-cbu-normalize.ts",
    "test:states": "tsx scripts/test-forensic-states.ts",
    "test:dedup": "tsx scripts/test-phash-dedup.ts",
    "test:global-dedup": "tsx scripts/test-global-dedup.ts",
    "test:ocr-code": "tsx scripts/test-ocr-code.ts",
    "test:code-sanity": "tsx scripts/test-code-sanity.ts",
    "test:ocr-corpus": "tsx scripts/test-ocr-corpus.ts",
    "test:ocr-feedback": "tsx scripts/test-ocr-feedback.ts",
    "ocr-eval:import": "tsx scripts/ocr-eval/import-batch.ts",
    "ocr-eval:report": "tsx scripts/ocr-eval/report.ts",
    "test:ai-retry": "tsx scripts/test-ai-retry.ts",
    "test:receipt-age": "tsx scripts/test-receipt-age.ts",
    "test:log-trail": "tsx scripts/test-log-trail.ts",
    "test:checksum": "tsx scripts/test-checksum-contrato.ts",
    "test:fecha-sanity": "tsx scripts/test-fecha-sanity.ts",
    "exp:fecha-anio": "tsx scripts/exp-fecha-anio.ts",
    "wipe:uat": "node dist/ops/wipe-uat-dedup-cli.js",
    "audit:acentos": "node scripts/audit-acentos.mjs",
    "test:traza-feed": "tsx scripts/test-traza-feed.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "clamscan": "^2.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "file-type": "^22.0.1",
    "openai": "^6.45.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "sharp": "^0.35.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.0.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
